<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_cyber_product_category_list" model="ir.ui.view">
        <field name="name">cyber.product.category.list</field>
        <field name="model">product.category</field>
        <field name="arch" type="xml">
            <list string="Danh mục sản phẩm">
                <field name="name"/>
                <field name="complete_name"/>
                <field name="parent_id"/>
                <field name="category_type"/>
                <field name="price_per_hours"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_cyber_product_category_form" model="ir.ui.view">
        <field name="name">cyber.product.category.form</field>
        <field name="model">product.category</field>
        <field name="arch" type="xml">
            <form string="Danh mục sản phẩm">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="category_type"/>
                        <field name="price_per_hours"
                            depends="category_type"
                            modifier="{'invisible': [('category_type', '!=', 'service')]}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cyber_product_category" model="ir.actions.act_window">
        <field name="name">Danh mục sản phẩm</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_cyber_product_category_list"/>
    </record>

    <!-- Menu -->
    <menuitem id="menu_cyber_product_category_root"
              name="Danh mục sản phẩm"
              parent="menu_cyber_product_sub"
              action="action_cyber_product_category"
              sequence="4"/>
</odoo>
