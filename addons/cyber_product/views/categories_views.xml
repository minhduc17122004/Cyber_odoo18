<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_cyber_product_category_list" model="ir.ui.view">
        <field name="name">cyber.product.category.list</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="category_type"/>
                <field name="price_list"/>
            </xpath>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_cyber_product_category_form" model="ir.ui.view">
        <field name="name">cyber.product.category.form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Cyber Info">
                    <field name="category_type"/>
                    <field name="price_list" 
                           invisible="category_type != 'service'"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cyber_product_category" model="ir.actions.act_window">
        <field name="name">Danh mục sản phẩm Cyber</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
     <menuitem id="menu_cyber_productconfig" name="Cấu hình sản phẩm" parent="menu_cyber_product_root" sequence ="11"/>
    <menuitem id="menu_cyber_category" name="Danh mục sản phẩm" parent="menu_cyber_productconfig" action="action_cyber_product_category" sequence ="1"/>
</odoo>
