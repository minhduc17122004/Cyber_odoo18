<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Machine list -->
    <record id="view_machine_list" model="ir.ui.view">
        <field name="name">product.machine.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Machine List">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="status"/>
                <field name="last_maintenance"/>
                <field name="categ_id"/>
            </list>
        </field>
    </record>

    <!-- Machine form -->
    <record id="view_machine_form" model="ir.ui.view">
        <field name="name">product.machine.form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form string="Machine Form">
                <group>
                    <field name="name"/>
                    <field name="serial_number"/>
                    <field name="status"/>
                    <field name="last_maintenance"/>
                    <field name="categ_id"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Service list -->
    <record id="view_service_list" model="ir.ui.view">
        <field name="name">product.service.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Service List">
                <field name="name"/>
                <field name="status"/>
                <field name="categ_id"/>
            </list>
        </field>
    </record>

    <!-- Service form -->
    <record id="view_service_form" model="ir.ui.view">
        <field name="name">product.service.form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form string="Service Form">
                <group>
                    <field name="name"/>
                    <field name="status"/>
                    <field name="categ_id"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_machine_list" model="ir.actions.act_window">
        <field name="name">Machines</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_machine_list"/>
        <field name="domain">[('is_machine','=',True)]</field>
        <field name="context">{'default_is_machine': True}</field>
    </record>

    <record id="action_service_list" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_service_list"/>
        <field name="domain">[('is_service','=',True)]</field>
        <field name="context">{'default_is_service': True}</field>
    </record>
</odoo>
