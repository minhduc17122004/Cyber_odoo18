<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--Service list -->
    <record id="view_cyber_service_list" model="ir.ui.view">
        <field name="name">cyber.service.tree</field>
        <field name="model">cyber.product</field>
        <field name="arch" type="xml">
            <list string="Service (Máy chơi game)">
                <field name="name"/>
                <field name="machine_status"/>
                <field name="location"/>
                <field name="ip_address"/>
                <field name="price_per_hour"/>
                <field name="usage_hours"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>
    <!--Service form-->
    <record id="view_cyber_service_form" model="ir.ui.view">
        <field name="name">cyber.service.form</field>
        <field name="model">cyber.product</field>
        <field name="arch" type="xml">
            <form string="Service Detail">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="machine_status"/>
                        <field name="location"/>
                        <field name="price_per_hour"/>
                        <field name="usage_hours"/>
                        <field name="machine_spec"/>
                        <field name="serial_number"/>
                        <field name="ip_address"/>
                        <field name="last_maintenance"/>
                        <field name="next_maintenance"/>
                        <field name="is_active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!--Service action-->
    <record id="action_cyber_service" model="ir.actions.act_window">
        <field name="name">Service (Máy chơi game)</field>
        <field name="res_model">cyber.product</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_cyber_service_tree"/>
        <field name="domain">[('is_service', '=', True)]</field>
        <field name="context">{'default_is_service': True}</field>
    </record>

    <!--Goods list-->
    <record id="view_cyber_goods_list" model="ir.ui.view">
        <field name="name">cyber.goods.tree</field>
        <field name="model">cyber.product</field>
        <field name="arch" type="xml">
            <list string="Goods (Hàng hóa)">
                <field name="name"/>
                <field name="category_id"/>
                <field name="list_price"/>
                <field name="cost_price"/>
                <field name="quantity_on_hand"/>
                <field name="expiry_date"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <!--Good form-->
    <record id="view_cyber_goods_form" model="ir.ui.view">
        <field name="name">cyber.goods.form</field>
        <field name="model">cyber.product</field>
        <field name="arch" type="xml">
            <form string="Goods Detail">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="barcode"/>
                        <field name="list_price"/>
                        <field name="cost_price"/>
                        <field name="tax_percent"/>
                        <field name="quantity_on_hand"/>
                        <field name="reorder_point"/>
                        <field name="uom_id"/>
                        <field name="expiry_date"/>
                        <field name="supplier_id"/>
                        <field name="is_active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--Goods action-->
    <record id="action_cyber_goods" model="ir.actions.act_window">
        <field name="name">Goods (Hàng hóa)</field>
        <field name="res_model">cyber.product</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_cyber_goods_tree"/>
        <field name="domain">[('is_good', '=', True)]</field>
        <field name="context">{'default_is_good': True}</field>
    </record>

    <!--Component list-->
    <record id="view_cyber_component_list" model="ir.ui.view">
        <field name="name">cyber.component.tree</field>
        <field name="model">cyber.product</field>
        <field name="arch" type="xml">
            <list string="Component (Linh kiện)">
                <field name="name"/>
                <field name="category_id"/>
                <field name="status"/>
                <field name="quantity"/>
                <field name="list_price"/>
                <field name="last_check"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <!--Component form-->
    <record id="view_cyber_component_form" model="ir.ui.view">
        <field name="name">cyber.component.form</field>
        <field name="model">cyber.product</field>
        <field name="arch" type="xml">
            <form string="Component Detail">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="list_price"/>
                        <field name="cost_price"/>
                        <field name="quantity"/>
                        <field name="uom_id"/>
                        <field name="compatible_machine"/>
                        <field name="install_date"/>
                        <field name="lifetime_hours"/>
                        <field name="status"/>
                        <field name="serial_number"/>
                        <field name="supplier_id"/>
                        <field name="last_check"/>
                        <field name="is_active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--Component action-->
    <record id="action_cyber_component" model="ir.actions.act_window">
        <field name="name">Component (Linh kiện)</field>
        <field name="res_model">cyber.product</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_cyber_component_tree"/>
        <field name="domain">[('is_component', '=', True)]</field>
        <field name="context">{'default_is_component': True}</field>
    </record>

    <!--Menu gốc -->
    <menuitem id="menu_cyber_product_root"
            name="Products"
            parent="base.menu_sales"
            sequence="10"/>
    <!--Menu service-->
    <menuitem id="menu_cyber_service"
            name="Service (Máy chơi game)"
            parent="menu_cyber_product_root"
            action="action_cyber_service"
            sequence="1"/>
    <!--Menu Goods-->
    <menuitem id="menu_cyber_goods"
            name="Goods (Hàng hóa)"
            parent="menu_cyber_product_root"
            action="action_cyber_goods"
            sequence="2"/>
    <!--Menu Components-->
    <menuitem id="menu_cyber_component"
            name="Component (Linh kiện)"
            parent="menu_cyber_product_root"
            action="action_cyber_component"
            sequence="3"/>
</odoo>
