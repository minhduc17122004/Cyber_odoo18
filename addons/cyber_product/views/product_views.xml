<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =================== LIST VIEWS =================== -->
    
    <!-- List view chung cho tất cả loại -->
    <record id="view_cyber_product_list" model="ir.ui.view">
        <field name="name">cyber.product.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_machine" string="Máy"/>
                <field name="is_good" string="Hàng"/>
                <field name="is_component" string="Linh kiện"/>
                <field name="list_price" string="Giá"/>
                <field name="type" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- =================== FORM VIEWS =================== -->
    
    <!-- Form chung - dùng notebook pages thay vì group với attrs -->
    <record id="view_cyber_product_form" model="ir.ui.view">
        <field name="name">cyber.product.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <!-- Chọn loại sản phẩm -->
                <group string="Loại sản phẩm Cyber" colspan="2">
                    <field name="is_machine" string="Máy dịch vụ"
                        modifiers="{'readonly': [('is_good','=',True), ('is_component','=',True)]}"/>
                    <field name="is_good" string="Hàng hóa"
                        modifiers="{'readonly': [('is_machine','=',True), ('is_component','=',True)]}"/>
                    <field name="is_component" string="Linh kiện"
                        modifiers="{'readonly': [('is_machine','=',True), ('is_good','=',True)]}"/>
                </group>

                <!-- Notebook với readonly fields -->
                <notebook>
                    <!-- TAB SERVICE -->
                    <page string="Service / Machine">
                        <group>
                            <field name="service_category_id" modifiers="{'readonly': [('is_machine','=',False)]}"/>
                            <field name="machine_status" modifiers="{'readonly': [('is_machine','=',False)]}"/>
                            <field name="machine_using_status" modifiers="{'readonly': [('is_machine','=',False)]}"/>
                            <field name="location" modifiers="{'readonly': [('is_machine','=',False)]}"/>
                            <field name="usage_hours" modifiers="{'readonly': [('is_machine','=',False)]}"/>
                            <field name="last_maintenance" modifiers="{'readonly': [('is_machine','=',False)]}"/>
                            <field name="next_maintenance" modifiers="{'readonly': [('is_machine','=',False)]}"/>
                            <field name="ip_address" modifiers="{'readonly': [('is_machine','=',False)]}"/>
                        </group>
                    </page>

                    <!-- TAB GOODS -->
                    <page string="Hàng hóa">
                        <group>
                            <field name="good_category_id" modifiers="{'readonly': [('is_good','=',False)]}"/>
                            <field name="uom_good_id" modifiers="{'readonly': [('is_good','=',False)]}"/>
                            <field name="supplier_good_id" modifiers="{'readonly': [('is_good','=',False)]}"/>
                            <field name="tax_percent" modifiers="{'readonly': [('is_good','=',False)]}"/>
                            <field name="expiry_date" modifiers="{'readonly': [('is_good','=',False)]}"/>
                            <field name="min_stock_good" modifiers="{'readonly': [('is_good','=',False)]}"/>
                            <field name="good_status" modifiers="{'readonly': [('is_good','=',False)]}"/>
                        </group>
                    </page>

                    <!-- TAB COMPONENT -->
                    <page string="Linh kiện">
                        <group>
                            <field name="component_category_id" modifiers="{'readonly': [('is_component','=',False)]}"/>
                            <field name="uom_component_id" modifiers="{'readonly': [('is_component','=',False)]}"/>
                            <field name="supplier_component_id" modifiers="{'readonly': [('is_component','=',False)]}"/>
                            <field name="lifetime_hours" modifiers="{'readonly': [('is_component','=',False)]}"/>
                            <field name="min_stock_component" modifiers="{'readonly': [('is_component','=',False)]}"/>
                            <field name="component_status" modifiers="{'readonly': [('is_component','=',False)]}"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- =================== ACTIONS =================== -->
    
    <record id="action_cyber_product" model="ir.actions.act_window">
        <field name="name">Sản phẩm Cyber</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[
            (ref('view_cyber_product_list'), 'list'),
            (ref('view_cyber_product_form'), 'form')
        ]"/>
        <field name="domain" eval="[
            '|', '|',
            ('is_machine', '=', True),
            ('is_good', '=', True),
            ('is_component', '=', True)
        ]"/>
    </record>

    <!-- =================== MENU =================== -->
    
    <menuitem id="menu_cyber_product_root" 
              name="Cyber Products" 
              sequence="10"/>
    
    <menuitem id="menu_cyber_product" 
              name="Sản phẩm" 
              parent="menu_cyber_product_root" 
              action="action_cyber_product" 
              sequence="1"/>

</odoo>