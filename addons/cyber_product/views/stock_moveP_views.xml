<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== VIEWS =================== -->
    
    <!-- List view cho Stock Picking -->
    <record id="view_cyber_stock_picking_list" model="ir.ui.view">
        <field name="name">cyber.stock.picking.list</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id" string="Nhà cung cấp"/>
                <field name="scheduled_date"/>
                <field name="is_cyber_picking" string="Cyber Picking"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form view cho Stock Picking -->
    <record id="view_cyber_stock_picking_form" model="ir.ui.view">
        <field name="name">cyber.stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id" string="Nhà cung cấp" domain="[('is_supplier_cyber','=',True)]"/>
                        <field name="scheduled_date"/>
                        <field name="state"/>
                        <field name="is_cyber_picking"/>
                        <field name="cyber_move_count"/>
                    </group>
                    <notebook>
                        <page string="Dòng sản phẩm">
                            <field name="move_ids_without_package">
                                <list editable="bottom">
                                    <field name="cyber_product_id"
                                           string="Sản phẩm Cyber"
                                           domain="['|','|',('is_machine','=',True),('is_good','=',True),('is_component','=',True)]"/>
                                    <field name="product_id" 
                                           string="Sản phẩm"
                                           context="{'default_type': 'product'}"/>
                                    <field name="product_uom_qty" string="Số lượng"/>
                                    <field name="product_uom" string="ĐVT"/>
                                    <field name="is_cyber_move" string="Cyber Move"/>
                                    <field name="state" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- List view cho Stock Move -->
    <record id="view_cyber_stock_move_list" model="ir.ui.view">
        <field name="name">cyber.stock.move.list</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <list>
                <field name="cyber_product_id" string="Sản phẩm Cyber"/>
                <field name="product_id" string="Sản phẩm"/>
                <field name="product_uom_qty" string="Số lượng"/>
                <field name="product_uom" string="ĐVT"/>
                <field name="is_machine"/>
                <field name="is_good"/>
                <field name="is_component"/>
                <field name="state"/>
                <field name="picking_id"/>
            </list>
        </field>
    </record>

    <!-- Form view cho Stock Move -->
    <record id="view_cyber_stock_move_form" model="ir.ui.view">
        <field name="name">cyber.stock.move.form</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Thông tin sản phẩm">
                        <field name="cyber_product_id" 
                               string="Sản phẩm Cyber"
                               domain="['|','|',('is_machine','=',True),('is_good','=',True),('is_component','=',True)]"/>
                        <field name="product_id" 
                               string="Sản phẩm"
                               context="{'default_type': 'product'}"/>
                        <field name="product_uom" string="ĐVT"/>
                        <field name="product_uom_qty" string="Số lượng"/>
                    </group>
                    <group string="Loại sản phẩm">
                        <field name="is_machine"/>
                        <field name="is_good"/>
                        <field name="is_component"/>
                        <field name="is_cyber_move"/>
                    </group>
                    <group string="Thông tin chung">
                        <field name="state"/>
                        <field name="picking_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- =================== ACTIONS =================== -->
    
    <record id="action_cyber_stock_in" model="ir.actions.act_window">
        <field name="name">Phiếu nhập kho Cyber</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[
                (ref('view_cyber_stock_picking_list'), 'list'),
                (ref('view_cyber_stock_picking_form'), 'form')
            ]"/>
        <field name="domain">[('picking_type_id.code','=','incoming')]</field>
        <field name="context" eval="{'default_picking_type_id': ref('stock.picking_type_in'), 'is_cyber_picking': True}"/>
    </record>

    <record id="action_cyber_stock_out" model="ir.actions.act_window">
        <field name="name">Phiếu xuất kho Cyber</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[
            (ref('view_cyber_stock_picking_list'), 'list'),
            (ref('view_cyber_stock_picking_form'), 'form')
        ]"/>
        <field name="domain">[('picking_type_id.code','=','outgoing'), ('partner_id.is_supplier_cyber','=',True)]</field>
        <field name="context" eval="{'default_picking_type_id': ref('stock.picking_type_out'), 'is_cyber_picking': True}"/>
    </record>

    <!-- =================== MENU =================== -->
    
    <menuitem id="menu_cyber_inventory_root" 
              name="Quản lý kho"
              parent ="menu_cyber_product_root"
              sequence="20"/>
    
    <menuitem id="menu_cyber_stock_in" 
              name="Phiếu nhập kho" 
              parent="menu_cyber_inventory_root" 
              action="action_cyber_stock_in" 
              sequence="10"/>
    
    <menuitem id="menu_cyber_stock_out" 
              name="Phiếu xuất kho" 
              parent="menu_cyber_inventory_root" 
              action="action_cyber_stock_out" 
              sequence="20"/>

</odoo>