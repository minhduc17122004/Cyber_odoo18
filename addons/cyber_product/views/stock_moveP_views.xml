<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== VIEWS =================== -->
    
    <!-- List view cho Stock Picking -->
    <record id="view_cyber_stock_picking_list" model="ir.ui.view">
        <field name="name">cyber.stock.picking.list</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="picking_type_id"/>
                <field name="scheduled_date"/>
                <field name="state"/>
                <field name="move_ids_without_package"/>
            </list>
        </field>
    </record>

    <!-- Form view cho Stock Picking -->
    <record id="view_cyber_stock_picking_form" model="ir.ui.view">
        <field name="name">cyber.stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="picking_type_id"/>
                        <field name="scheduled_date"/>
                        <field name="state"/>
                        <field name="partner_id" string="Nhà cung cấp"/>
                    </group>
                    <notebook>
                        <page string="Dòng sản phẩm">
                            <field name="move_ids_without_package">
                                <list editable="bottom">
                                    <!-- Thay vì chỉ có product_id, ta thêm cyber_product_id có domain động -->
                                    <field name="cyber_product_id"
                                           string="Sản phẩm Cyber"
                                           domain="[
                                               '|','|',
                                               ('supplier_good_id', '=', parent.partner_id),
                                               ('supplier_component_id', '=', parent.partner_id),
                                               ('supplier_service_id', '=', parent.partner_id)
                                           ]"/>
                                    <field name="product_id" invisible="1" context="{'default_type': 'product'}" options="{'no_create': False}"/> <!-- Ẩn product_id gốc để vẫn tính toán liên quan -->
                                    <field name="product_uom_qty"/>
                                    <field name="state"/>
                                    <field name="is_machine"/>
                                    <field name="is_good"/>
                                    <field name="is_component"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- List view cho Stock Move -->
    <record id="view_cyber_stock_move_list" model="ir.ui.view">
        <field name="name">cyber.stock.move.list</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id" context="{'default_type': 'product'}" options="{'no_create': False}"/>
                <field name="product_uom_qty"/>
                <field name="is_machine"/>
                <field name="is_good"/>
                <field name="is_component"/>
                <field name="state"/>
                <field name="picking_id"/>
            </list>
        </field>
    </record>

    <!-- Form view cho Stock Move -->
    <record id="view_cyber_stock_move_form" model="ir.ui.view">
        <field name="name">cyber.stock.move.form</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_id" context="{'default_type': 'product'}" options="{'no_create': False}"/>
                        <field name="product_uom_qty"/>
                        <field name="state"/>
                        <field name="picking_id"/>
                    </group>
                    <group>
                        <field name="is_machine"/>
                        <field name="is_good"/>
                        <field name="is_component"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- =================== MENU =================== -->

    <menuitem id="menu_cyber_inventory_root" name="Cyber Inventory" parent="menu_cyber_product_root" sequence="10"/>
    <menuitem id="menu_cyber_stock_in" name="Phiếu nhập kho" parent="menu_cyber_inventory_root" sequence="1"/>
    <menuitem id="menu_cyber_stock_out" name="Phiếu xuất kho" parent="menu_cyber_inventory_root" sequence="2"/>

    <!-- =================== ACTIONS =================== -->

    <record id="action_cyber_stock_in" model="ir.actions.act_window">
        <field name="name">Phiếu nhập kho Cyber</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('picking_type_id.code','=','incoming')]</field>
    </record>
    <menuitem id="menu_cyber_stock_in_action" name="Phiếu nhập kho" parent="menu_cyber_stock_in" action="action_cyber_stock_in"/>

    <record id="action_cyber_stock_out" model="ir.actions.act_window">
        <field name="name">Phiếu xuất kho Cyber</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('picking_type_id.code','=','outgoing')]</field>
    </record>
    <menuitem id="menu_cyber_stock_out_action" name="Phiếu xuất kho" parent="menu_cyber_stock_out" action="action_cyber_stock_out"/>
</odoo>
