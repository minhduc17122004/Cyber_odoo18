<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List view -->
    <record id="view_cyber_supplier_list" model="ir.ui.view">
        <field name="name">cyber.supplier.list</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="is_supplier_cyber"/>
                <field name="supplier_type"/>
            </xpath>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_cyber_supplier_form" model="ir.ui.view">
        <field name="name">cyber.supplier.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Cyber Supplier Info">
                    <field name="is_supplier_cyber"/>
                    <field name="supplier_type"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ======= Action ======= -->
    <record id="action_cyber_supplier" model="ir.actions.act_window">
        <field name="name">Nhà cung cấp Cyber</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_supplier_cyber','=',True)]</field>
        <field name="views" eval="[
            (ref('view_cyber_supplier_list'), 'list'),
            (ref('view_cyber_supplier_form'), 'form')
        ]"/>
    </record>

    <!-- ======= Menu ======= -->
    <menuitem id="menu_cyber_supplier" name="Nhà cung cấp" parent="menu_cyber_product_root" action="action_cyber_supplier" sequence ="6"/>
</odoo>
