<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_cyber_uom_list" model="ir.ui.view">
        <field name="name">cyber.uom.list</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.product_uom_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="uom_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_cyber_uom_form" model="ir.ui.view">
        <field name="name">cyber.uom.form</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.product_uom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="uom_type"/>
            </xpath>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cyber_uom" model="ir.actions.act_window">
        <field name="name">Đơn vị tính Cyber</field>
        <field name="res_model">uom.uom</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[
            (ref('view_cyber_uom_list'), 'list'),
            (ref('view_cyber_uom_form'), 'form')
        ]"/>
    </record>

    <!-- Menu -->
    <menuitem id="menu_cyber_uom" name="Đơn vị tính" parent="menu_cyber_product_root" action="action_cyber_uom" sequence ="5"/>
</odoo>
