<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tạo UoM Categories -->
    <record id="uom_categ_cyber_good" model="uom.category">
        <field name="name">Cyber Hàng Hóa</field>
        <field name="cyber_category_type">good</field>
    </record>

    <record id="uom_categ_cyber_component" model="uom.category">
        <field name="name">Cyber Linh Kiện</field>
        <field name="cyber_category_type">component</field>
    </record>

    <record id="uom_categ_cyber_service" model="uom.category">
        <field name="name">Cyber Máy Dịch Vụ</field>
        <field name="cyber_category_type">service</field>
    </record>

    <!-- Tạo Reference Unit cho mỗi category (chỉ 1 cái thôi) -->
    <record id="uom_cyber_good_unit" model="uom.uom">
        <field name="name">Cái</field>
        <field name="category_id" ref="uom_categ_cyber_good"/>
        <field name="uom_type">reference</field>
        <field name="cyber_uom_type">good</field>
    </record>

    <record id="uom_cyber_component_unit" model="uom.uom">
        <field name="name">Bộ</field>
        <field name="category_id" ref="uom_categ_cyber_component"/>
        <field name="uom_type">reference</field>
        <field name="cyber_uom_type">component</field>
    </record>

    <record id="uom_cyber_service_unit" model="uom.uom">
        <field name="name">Lần</field>
        <field name="category_id" ref="uom_categ_cyber_service"/>
        <field name="uom_type">reference</field>
        <field name="cyber_uom_type">service</field>
    </record>

    <!-- Tạo thêm smaller units -->
    <record id="uom_cyber_good_unit_smaller" model="uom.uom">
        <field name="name">Chiếc</field>
        <field name="category_id" ref="uom_categ_cyber_good"/>
        <field name="uom_type">smaller</field>
        <field name="factor">2</field>
        <field name="cyber_uom_type">good</field>
    </record>

    <record id="uom_cyber_component_unit_smaller" model="uom.uom">
        <field name="name">Cái</field>
        <field name="category_id" ref="uom_categ_cyber_component"/>
        <field name="uom_type">smaller</field>
        <field name="factor">2</field>
        <field name="cyber_uom_type">component</field>
    </record>

    <record id="uom_cyber_service_unit_smaller" model="uom.uom">
        <field name="name">Buổi</field>
        <field name="category_id" ref="uom_categ_cyber_service"/>
        <field name="uom_type">smaller</field>
        <field name="factor">2</field>
        <field name="cyber_uom_type">service</field>
    </record>

    <!-- List View -->
    <record id="view_cyber_uom_list" model="ir.ui.view">
        <field name="name">cyber.uom.list</field>
        <field name="model">uom.uom</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Units of Measure">
                <field name="name"/>
                <field name="category_id"/>
                <field name="uom_type"/>
                <field name="cyber_uom_type"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_cyber_uom_form" model="ir.ui.view">
        <field name="name">cyber.uom.form</field>
        <field name="model">uom.uom</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Units of Measure">
                <sheet>
                    <group>
                        <group name="uom_details">
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="uom_type"/>
                            <field name="cyber_uom_type"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cyber_uom" model="ir.actions.act_window">
        <field name="name">Đơn vị tính Cyber</field>
        <field name="res_model">uom.uom</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[
            (ref('view_cyber_uom_list'), 'list'),
            (ref('view_cyber_uom_form'), 'form')
        ]"/>
    </record>

    <!-- Menu -->
    <menuitem id="menu_cyber_uom" name="Đơn vị tính" parent="menu_cyber_productconfig" action="action_cyber_uom" sequence="5"/>
</odoo>