<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_cyber_uom_list" model="ir.ui.view">
        <field name="name">cyber.uom.list</field>
        <field name="model">cyber.uom</field>
        <field name="arch" type="xml">
            <list string="Đơn vị tính">
                <field name="name"/>
                <field name="uom_type"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_cyber_uom_form" model="ir.ui.view">
        <field name="name">cyber.uom.form</field>
        <field name="model">cyber.uom</field>
        <field name="arch" type="xml">
            <form string="Đơn vị tính">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="uom_type"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cyber_uom" model="ir.actions.act_window">
        <field name="name">Đơn vị tính</field>
        <field name="res_model">cyber.uom</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_cyber_uom_list"/>
    </record>

    <!-- Menu -->
    <menuitem id="menu_cyber_uom"
              name="Đơn vị tính"
              parent="menu_cyber_product_sub"
              action="action_cyber_uom"
              sequence="5"/>
</odoo>
