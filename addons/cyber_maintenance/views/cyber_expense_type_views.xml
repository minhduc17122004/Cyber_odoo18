<odoo>
    <record id="view_cyber_expense_type_tree" model="ir.ui.view">
        <field name="name">cyber.expense.type.tree</field>
        <field name="model">cyber.expense.type</field>
        <field name="arch" type="xml">
            <list string="Expense Types">
                <field name="name"/>
                <field name="amount_default"/>
                <field name="is_fixed"/>
            </list>
        </field>
    </record>

    <record id="view_cyber_expense_type_form" model="ir.ui.view">
        <field name="name">cyber.expense.type.form</field>
        <field name="model">cyber.expense.type</field>
        <field name="arch" type="xml">
            <form string="Expense Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="amount_default"/>
                        <field name="is_fixed"/>
                    </group>

                    <notebook>
                        <page string="Ghi chú">
                            <field name="description" placeholder="Ghi chú..." widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>



    <record id="action_cyber_expense_type" model="ir.actions.act_window">
        <field name="name">Quản lý loại chi phí</field>
        <field name="res_model">cyber.expense.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem   id="menu_cyber_expenses_type" 
                name="Quản lý loại chi phí"
                parent="menu_cyber_maintenance_root" 
                action="action_cyber_expense_type" 
                sequence="40"/>
</odoo>
