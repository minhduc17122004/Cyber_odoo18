<odoo>
    <!-- Tree view đơn giản cho maintenance.request -->
    <record id="view_maintenance_request_tree_inherit_cyber" model="ir.ui.view">
        <field name="name">maintenance.request.tree.inherit.cyber</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <!-- <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="cyber_machine_id"/>
            </xpath>
        </field> -->
    </record>

    <!-- Form view kế thừa thêm trường cyber_machine_id -->
    <record id="view_maintenance_request_form_inherit_cyber" model="ir.ui.view">
        <field name="name">maintenance.request.form.inherit.cyber</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='equipment_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='email_cc']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='maintenance_type']" position="before">
                <field name="cyber_machine_id"/>
            </xpath>
        </field>
    </record>

    <!-- Action window với view tree và form -->
    <record id="action_cyber_maintenance_requests" model="ir.actions.act_window">
        <field name="name">Yêu cầu bảo trì</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_maintenance_request_tree_inherit_cyber"/>
    </record>

    <!-- Menu -->
    <menuitem id="menu_cyber_maintenance_root" name="Cyber Maintenance" sequence="30" />
    <menuitem id="menu_cyber_maintenance_requests" name="Yêu cầu bảo trì" parent="menu_cyber_maintenance_root" action="action_cyber_maintenance_requests" sequence="10"/>
</odoo>
