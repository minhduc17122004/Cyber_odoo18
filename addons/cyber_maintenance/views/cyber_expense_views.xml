<odoo>
    <record id="view_cyber_expense_tree" model="ir.ui.view">
        <field name="name">cyber.expense.tree</field>
        <field name="model">cyber.expense</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="amount"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <record id="view_cyber_expense_form" model="ir.ui.view">
        <field name="name">cyber.expense.form</field>
        <field name="model">cyber.expense</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="amount"/>
                        <field name="date"/>
                        <field name="state"/>
                        <field name="maintenance_id"/>
                        <field name="expense_type_id"/>
                    </group>

                    <notebook>
                        <page string="Ghi chú">
                            <field name="description" placeholder="Ghi chú..." widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_cyber_expense" model="ir.actions.act_window">
        <field name="name">Quản lý chi phí</field>
        <field name="res_model">cyber.expense</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem   id="menu_cyber_expenses" 
                name="Quản lý chi phí"
                parent="menu_cyber_maintenance_root" 
                action="action_cyber_expense" 
                sequence="30"/>
</odoo>
