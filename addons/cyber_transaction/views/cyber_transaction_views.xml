<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ===== Form View ===== -->
        <record id="cyber_transaction_form_view" model="ir.ui.view">
            <field name="name">cyber.transaction.form.view</field>
            <field name="model">cyber.transaction</field>
            <field name="arch" type="xml">
                <form string="Giao dịch">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <label for="account_id" string="Tài khoản"/>
                                <field name="account_id" options="{'no_create': True}"/>
                            </h1>
                        </div>

                        <group name="main_info">
                            <group>
                                <field name="type" string="Loại giao dịch"/>
                                <field name="payment_method" string="Phương thức thanh toán"/>
                            </group>
                            <group>
                                <field name="amount" string="Số tiền"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ===== Tree View ===== -->
        <record id="cyber_transaction_tree_view" model="ir.ui.view">
            <field name="name">cyber.transaction.tree.view</field>
            <field name="model">cyber.transaction</field>
            <field name="arch" type="xml">
                <list string="Danh sách giao dịch" default_order="create_date desc">
                    <field name="account_id" string="Tài khoản"/>
                    <field name="type" string="Loại giao dịch"/>
                    <field name="amount" string="Số tiền"/>
                    <field name="payment_method" string="Phương thức thanh toán"/>
                    <field name="create_date" string="Ngày tạo"/>
                </list>
            </field>
        </record>

        <!-- ===== Action ===== -->
        <record id="action_cyber_transaction" model="ir.actions.act_window">
            <field name="name">Giao dịch</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">cyber.transaction</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ===== Menu Gốc ===== -->
        <menuitem id="menu_cyber_transaction_root"
            name="Cyber Transaction"
            sequence="10"
            groups="base.group_user"/>

        <!-- ===== Menu Con ===== -->
        <menuitem id="menu_cyber_transaction"
            name="Giao dịch"
            parent="menu_cyber_transaction_root"
            action="action_cyber_transaction"
            sequence="20"
            groups="base.group_user"/>

    </data>
</odoo>
