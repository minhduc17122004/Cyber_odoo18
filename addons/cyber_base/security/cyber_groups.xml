<odoo>
  <data noupdate="1">

    <!-- Nhóm quyền người dùng -->
    <record id="group_cyber_user" model="res.groups">
      <field name="name">Cyber User</field>
      <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <!-- Nhóm quyền quản lý -->
    <record id="group_cyber_manager" model="res.groups">
      <field name="name">Cyber Manager</field>
      <field name="implied_ids" eval="[(4, ref('group_cyber_user'))]"/>
    </record>

    <!-- Nhóm quyền quản trị -->
    <record id="group_cyber_admin" model="res.groups">
      <field name="name">Cyber Administrator</field>
      <field name="implied_ids" eval="[(4, ref('group_cyber_manager'))]"/>
      <field name="category_id" ref="base.module_category_administration"/>
    </record>

  </data>
</odoo>