<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Gaming Machines Category -->
        <record id="product_category_gaming_machines" model="product.category">
            <field name="name">Gaming Machines</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>

        <!-- Food & Beverage Category -->
        <record id="product_category_food" model="product.category">
            <field name="name">Food</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>

        <record id="product_category_drinks" model="product.category">
            <field name="name">Drinks</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>

        <!-- Services Category -->
        <record id="product_category_cyber_services" model="product.category">
            <field name="name">Cyber Services</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>
    </data>
</odoo>
