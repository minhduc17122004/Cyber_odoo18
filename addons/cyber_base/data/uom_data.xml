<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Time-based UoM Category -->
        <record id="uom_categ_cyber_time" model="uom.category">
            <field name="name">Time (Cyber)</field>
        </record>

        <record id="product_uom_hour" model="uom.uom">
            <field name="name">Hour(s)</field>
            <field name="category_id" ref="uom_categ_cyber_time"/>
            <field name="factor" eval="1.0"/>
            <field name="uom_type">reference</field>
            <field name="rounding">0.01</field>
        </record>

        <record id="product_uom_minute" model="uom.uom">
            <field name="name">Minute(s)</field>
            <field name="category_id" ref="uom_categ_cyber_time"/>
            <field name="factor" eval="60.0"/>
            <field name="uom_type">smaller</field>
            <field name="rounding">0.01</field>
        </record>

        <!-- Drinks UoM Category -->
        <record id="uom_categ_cyber_drinks" model="uom.category">
            <field name="name">Drinks (Cyber)</field>
        </record>

        <record id="product_uom_cup" model="uom.uom">
            <field name="name">Cup(s)</field>
            <field name="category_id" ref="uom_categ_cyber_drinks"/>
            <field name="factor" eval="1.0"/>
            <field name="uom_type">reference</field>
            <field name="rounding">1.0</field>
        </record>

        <!-- Package UoM Category -->
        <record id="uom_categ_cyber_packages" model="uom.category">
            <field name="name">Packages (Cyber)</field>
        </record>

        <record id="product_uom_package" model="uom.uom">
            <field name="name">Package(s)</field>
            <field name="category_id" ref="uom_categ_cyber_packages"/>
            <field name="factor" eval="1.0"/>
            <field name="uom_type">reference</field>
            <field name="rounding">1.0</field>
        </record>
    </data>
</odoo>
