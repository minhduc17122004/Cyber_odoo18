<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>


        <!-- ====================================================== -->
        <!-- FORM VIEW: INHERIT ACCOUNT.MOVE                        -->
        <!-- ====================================================== -->
        <record id="view_move_form_inherit_cyber" model="ir.ui.view">
            <field name="name">account.move.form.inherit.cyber</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <!-- ===== ẨN field khách hàng gốc của Odoo ===== -->
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>


                <!-- ===== THÊM GROUP CYBER INFO SAU INVOICE_DATE ===== -->
                <xpath expr="//sheet//group[field[@name='invoice_date']]" position="after">
                    
                    <group string="Thông tin Phiên Chơi" name="cyber_session_info" colspan="2">
                        <!-- Session ID -->
                        <field name="session_id"
                            domain="[('session_state', '=', 'closed')]"
                            options="{'no_create': True}"/>
                       
                        <!-- Khách hàng - Hiển thị từ partner_id (readonly) -->
                        <field name="partner_id" 
                            string="Khách hàng"
                            readonly="True"
                            options="{'no_create': True}"/>
                       
                        <!-- Tài khoản - Hiển thị và editable -->
                        <field name="account_id"
                            readonly="False"
                            options="{'no_create': True}"/>
                    </group>


                    <group string="Chi phí - Thời lượng" name="cyber_cost_info" colspan="2">
                        <!-- Tổng chi phí gốc -->
                        <field name="total_cost" readonly="True"/>
                       
                        <!-- Thời lượng -->
                        <field name="duration" readonly="True"/>
                    </group>


                    <!-- ===== ĐIỀU CHỈNH CHI PHÍ: CẬP NHẬT total_cost ===== -->
                    <group string="Điều chỉnh Chi phí" name="cyber_adjustment" colspan="2">
                        <field name="discount_percent" 
                            string="Giảm giá (%)"/>
                        
                        <field name="surcharge_percent" 
                            string="Phụ phí (%)"/>
                        
                        <field name="tax_percent" 
                            string="Thuế (%)"/>
                        
                        <!-- Hiển thị tổng chi phí sau điều chỉnh -->
                        <field name="total_cost" 
                            readonly="True" 
                            string="Tổng chi phí (sau điều chỉnh)"
                            nolabel="False"/>
                    </group>

                </xpath>


                <!-- ===== GCHI CHÚ THÊM ===== -->
                <xpath expr="//field[@name='narration']" position="after">
                    <field name="note_cyber" 
                        string="Ghi chú Cyber" 
                        placeholder="Ghi chú thêm về phiên chơi..."/>
                </xpath>

            </field>
        </record>




        <!-- ====================================================== -->
        <!-- LIST VIEW CYBER INVOICE                                -->
        <!-- ====================================================== -->
        <record id="view_move_list_cyber_invoice" model="ir.ui.view">
            <field name="name">account.move.list.cyber</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <list string="Cyber Hóa đơn">
                    <field name="name"/>
                    <field name="invoice_date"/>
                    <field name="partner_id" string="Khách hàng"/>
                    <field name="session_id"/>
                    <field name="account_id"/>
                    <field name="total_cost"/>
                    <field name="duration"/>
                    <field name="amount_total"/>
                    <field name="state"/>
                </list>
            </field>
        </record>




        <!-- ====================================================== -->
        <!-- PAYMENT METHOD TRONG INVOICE LINE (Tree trong Form)    -->
        <!-- ====================================================== -->
        <record id="view_move_form_inherit_payment_method" model="ir.ui.view">
            <field name="name">account.move.form.inherit.payment.method</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Thêm field payment_method vào invoice_line_ids list -->
                <xpath expr="//field[@name='invoice_line_ids']//field[@name='quantity']" position="after">
                    <field name="payment_method" optional="show"/>
                </xpath>
            </field>
        </record>




        <!-- ====================================================== -->
        <!-- PAYMENT METHOD TRONG POPUP FORM INVOICE LINE           -->
        <!-- ====================================================== -->
        <record id="view_invoice_line_form_inherit_payment" model="ir.ui.view">
            <field name="name">invoice.line.form.inherit.payment.method</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_form"/>
            <field name="arch" type="xml">
                <!-- Thêm field payment_method vào form view của invoice line -->
                <xpath expr="//field[@name='name']" position="after">
                    <field name="payment_method"/>
                </xpath>
            </field>
        </record>




        <!-- ====================================================== -->
        <!-- ACTION & MENU                                          -->
        <!-- ====================================================== -->
        <record id="action_cyber_invoice" model="ir.actions.act_window">
            <field name="name">Cyber Hóa đơn</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_move_list_cyber_invoice"/>
            <field name="domain">[('session_id','!=',False)]</field>
            <field name="context">{}</field>
        </record>


        <menuitem id="menu_cyber_invoice_root"
                  name="Cyber Invoice"
                  sequence="10"
                  groups="base.group_user"/>


        <menuitem id="menu_cyber_invoice"
                  name="Hóa đơn"
                  parent="menu_cyber_invoice_root"
                  action="action_cyber_invoice"
                  sequence="20"
                  groups="base.group_user"/>


    </data>
</odoo>