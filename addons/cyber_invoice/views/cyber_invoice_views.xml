<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ====================================== -->
        <!-- FORM VIEW: KẾ THỪA ACCOUNT.MOVE FORM -->
        <!-- ====================================== -->
        <record id="view_move_form_inherit_cyber" model="ir.ui.view">
            <field name="name">account.move.form.inherit.cyber</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Thêm nhóm thông tin Cyber mà không xóa các field gốc -->
                <xpath expr="//sheet//group[field[@name='invoice_date']]" position="after">
                    <group string="Thông tin Cyber">
                        <field name="customer_id" options="{'no_create': True}" required="1"/>
                        <field name="session_id" options="{'no_create': True}"/>
                        <field name="transaction_id" options="{'no_create': True}"/>
                        <field name="total_cost"/>
                        <field name="discount_percent"/>
                        <field name="surcharge_percent"/>
                        <field name="tax_percent"/>
                        <field name="duration" readonly="1"/>
                        <field name="note_cyber" placeholder="Ghi chú thêm..."/>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- ====================================== -->
        <!-- LIST VIEW RIÊNG CHO CYBER INVOICE -->
        <!-- ====================================== -->
        <record id="view_move_list_cyber_invoice" model="ir.ui.view">
            <field name="name">account.move.list.cyber</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <list string="Cyber Hóa đơn">
                    <field name="customer_id"/>
                    <field name="session_id"/>
                    <field name="transaction_id"/>
                    <field name="total_cost"/>
                    <field name="discount_percent"/>
                    <field name="surcharge_percent"/>
                    <field name="tax_percent"/>
                    <field name="duration"/>
                    <field name="amount_total"/>
                </list>
            </field>
        </record>

        <!-- ====================================== -->
        <!-- ACTION & MENU -->
        <!-- ====================================== -->
        <record id="action_cyber_invoice" model="ir.actions.act_window">
            <field name="name">Cyber Hóa đơn</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_move_list_cyber_invoice"/>
            <field name="domain">[('session_id','!=',False)]</field>

            <!-- 🟩 Thêm dòng context này để chặn Odoo tự ép default_journal_id -->
            <field name="context">{'default_journal_id': False}</field>
        </record>

        <menuitem id="menu_cyber_invoice_root"
                  name="Cyber Invoice"
                  sequence="10"
                  groups="base.group_user"/>

        <menuitem id="menu_cyber_invoice"
                  name="Hóa đơn"
                  parent="menu_cyber_invoice_root"
                  action="action_cyber_invoice"
                  sequence="20"
                  groups="base.group_user"/>

    </data>
</odoo>
