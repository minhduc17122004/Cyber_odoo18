<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ====================================================== -->
        <!-- FORM VIEW: INHERIT ACCOUNT.MOVE                        -->
        <!-- ====================================================== -->
        <record id="view_move_form_inherit_cyber" model="ir.ui.view">
            <field name="name">account.move.form.inherit.cyber</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <!-- ẨN field khách hàng gốc -->
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- Nhóm Thông tin Cyber -->
                <xpath expr="//sheet//group[field[@name='invoice_date']]" position="after">
                    <group string="Thông tin Cyber">
                        <field name="customer_id" required="1" options="{'no_create': True}"/>
                        <field name="session_id" options="{'no_create': True}"/>
                        <field name="account_id" options="{'no_create': True}"/>
                        <field name="total_cost"/>
                        <field name="note_cyber" placeholder="Ghi chú thêm..."/>
                    </group>
                </xpath>

            </field>
        </record>


        <!-- ====================================================== -->
        <!-- LIST VIEW CYBER INVOICE                                -->
        <!-- ====================================================== -->
        <record id="view_move_list_cyber_invoice" model="ir.ui.view">
            <field name="name">account.move.list.cyber</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <list string="Cyber Hóa đơn">
                    <field name="customer_id"/>
                    <field name="session_id"/>
                    <field name="account_id"/>
                    <field name="total_cost"/>
                    <field name="amount_total"/>
                </list>
            </field>
        </record>


        <!-- ====================================================== -->
        <!-- PAYMENT METHOD TRONG INVOICE LINE (Tree)               -->
        <!-- ====================================================== -->
        <record id="view_invoice_line_tree_inherit_payment" model="ir.ui.view">
            <field name="name">invoice.line.tree.inherit.payment.method</field>
            <field name="model">account.move.line</field>

            <!-- Tree view invoice line của Odoo 18 -->
            <field name="inherit_id" ref="account.view_move_line_tree"/>

            <field name="arch" type="xml">
                <!-- thêm cột vào cuối tree -->
                <xpath expr="//list" position="inside">
                    <field name="payment_method" optional="show"/>
                </xpath>
            </field>
        </record>


        <!-- ====================================================== -->
        <!-- PAYMENT METHOD TRONG POPUP FORM INVOICE LINE           -->
        <!-- ====================================================== -->
        <record id="view_invoice_line_form_inherit_payment" model="ir.ui.view">
            <field name="name">invoice.line.form.inherit.payment.method</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_form"/>

            <field name="arch" type="xml">
                <xpath expr="//group" position="inside">
                    <field name="payment_method"/>
                </xpath>
            </field>
        </record>


        <!-- ====================================================== -->
        <!-- ACTION & MENU                                          -->
        <!-- ====================================================== -->
        <record id="action_cyber_invoice" model="ir.actions.act_window">
            <field name="name">Cyber Hóa đơn</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_move_list_cyber_invoice"/>
            <field name="domain">[('session_id','!=',False)]</field>
            <field name="context">{'default_journal_id': False}</field>
        </record>

        <menuitem id="menu_cyber_invoice_root"
                  name="Cyber Invoice"
                  sequence="10"
                  groups="base.group_user"/>

        <menuitem id="menu_cyber_invoice"
                  name="Hóa đơn"
                  parent="menu_cyber_invoice_root"
                  action="action_cyber_invoice"
                  sequence="20"
                  groups="base.group_user"/>

    </data>
</odoo>
