<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ====================================================== -->
    <!-- NOTE: NỘI DUNG NÀY ĐƯỢC CHUYỂN TỪ cyber_invoice_views.xml -->
    <!-- Đây là file root chính chứa các view và menu chính -->
    <!-- ====================================================== -->

    <!-- ====================================================== -->
    <!-- FORM VIEW: INHERIT ACCOUNT.MOVE                        -->
    <!-- ====================================================== -->
    <record id="view_move_form_inherit_cyber" model="ir.ui.view">
        <field name="name">account.move.form.inherit.cyber</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- ===== ẨN field khách hàng gốc của Odoo (nếu có) ===== -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ===== THÊM KHÁCH HÀNG NGAY SAU INVOICE_DATE ===== -->
            <xpath expr="//sheet//group[field[@name='invoice_date']]/field[@name='invoice_date']" position="after">
                <field name="partner_id" 
                    string="Khách hàng"
                    readonly="True"
                    options="{'no_create': True}"/>
            </xpath>

            <!-- ===== THÊM GROUP CYBER INFO SAU INVOICE_DATE GROUP ===== -->
            <xpath expr="//sheet//group[field[@name='invoice_date']]" position="after">
                
                <group string="Thông tin Phiên Chơi" name="cyber_session_info" colspan="2">
                    <!-- Session ID -->
                    <field name="session_id"
                        domain="[('session_state', '=', 'closed')]"
                        options="{'no_create': True}"/>
                   
                    <!-- Tài khoản - Hiển thị và editable -->
                    <field name="account_id"
                        readonly="False"
                        options="{'no_create': True}"/>
                </group>

            </xpath>


            <!-- ===== GCHI CHÚ THÊM ===== -->
            <xpath expr="//field[@name='narration']" position="after">
                <field name="note_cyber" 
                    string="Ghi chú Cyber" 
                    placeholder="Ghi chú thêm về phiên chơi..."/>
            </xpath>

        </field>
    </record>




    <!-- ====================================================== -->
    <!-- LIST VIEW CYBER INVOICE                                -->
    <!-- ====================================================== -->
    <record id="view_move_list_cyber_invoice" model="ir.ui.view">
        <field name="name">account.move.list.cyber</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Cyber Hóa đơn">
                <field name="name"/>
                <field name="invoice_date"/>
                <field name="partner_id" string="Khách hàng"/>
                <field name="session_id"/>
                <field name="account_id"/>
                <field name="total_cost"/>
                <field name="duration"/>
                <field name="amount_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>




    <!-- ====================================================== -->
    <!-- PAYMENT METHOD TRONG INVOICE LINE (Tree trong Form)    -->
    <!-- ====================================================== -->
    <record id="view_move_form_inherit_payment_method" model="ir.ui.view">
        <field name="name">account.move.form.inherit.payment.method</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Thêm field payment_method vào invoice_line_ids list -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='quantity']" position="after">
                <field name="payment_method" optional="show"/>
            </xpath>
        </field>
    </record>




    <!-- ====================================================== -->
    <!-- PAYMENT METHOD TRONG POPUP FORM INVOICE LINE           -->
    <!-- ====================================================== -->
    <record id="view_invoice_line_form_inherit_payment" model="ir.ui.view">
        <field name="name">invoice.line.form.inherit.payment.method</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <!-- Thêm field payment_method vào form view của invoice line -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="payment_method"/>
            </xpath>
        </field>
    </record>




    <!-- ====================================================== -->
    <!-- ACTION & MENU (ROOT MENU)                              -->
    <!-- ====================================================== -->
    <record id="action_cyber_invoice" model="ir.actions.act_window">
        <field name="name">Cyber Hóa đơn</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_move_list_cyber_invoice"/>
        <field name="domain">[('session_id','!=',False)]</field>
        <field name="context">{}</field>
    </record>


    <menuitem id="menu_cyber_invoice_root"
              name="Cyber Invoice"
              sequence="10"
              groups="base.group_user"/>

    <!-- NOTE: Đã xóa menu "Hóa đơn" (menu_cyber_invoice) vì thừa, chỉ giữ lại action để có thể dùng sau này nếu cần -->

    <!-- ====================================================== -->
    <!-- END: NỘI DUNG CHUYỂN TỪ cyber_invoice_views.xml        -->
    <!-- ====================================================== -->


    <!-- ====================================================== -->
    <!-- MENU KHÁCH HÀNG (GIỮ NGUYÊN)                          -->
    <!-- ====================================================== -->
    <!-- MENU KHÁCH HÀNG -->
    <menuitem id="menu_cyber_customer_root"
              name="Khách hàng"
              parent="menu_cyber_invoice_root"
              sequence="10"/>

    <!-- LIST VIEW -->
    <record id="view_cyber_customer_list" model="ir.ui.view">
        <field name="name">cyber.customer.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Hóa đơn khách hàng">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="amount_total"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_cyber_customer_form" model="ir.ui.view">
        <field name="name">cyber.customer.form</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <form string="Hóa đơn khách hàng">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="invoice_date"/>
                        <field name="amount_total"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTIONS -->
    <!-- Action Hóa đơn -->
    <record id="action_cyber_customer_invoice" model="ir.actions.act_window">
        <field name="name">Hóa đơn</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'default_journal_id': False}</field>
    </record>

    <!-- Action Giấy báo có (Credit Note) -->
    <record id="action_cyber_customer_credit_note" model="ir.actions.act_window">
        <field name="name">Giấy báo có</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_refund')]</field>
        <field name="context">{'default_move_type': 'out_refund', 'default_journal_id': False}</field>
    </record>

    <!-- Action Thanh toán (Payment) -->
    <record id="action_cyber_customer_payment" model="ir.actions.act_window">
        <field name="name">Thanh toán</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_type', '=', 'inbound'), ('partner_type', '=', 'customer')]</field>
        <field name="context">{'default_payment_type': 'inbound', 'default_partner_type': 'customer'}</field>
    </record>

    <!-- MENU ITEMS -->
    <menuitem id="menu_cyber_customer_invoice"
              parent="menu_cyber_customer_root"
              name="Hóa đơn"
              action="action_cyber_customer_invoice"
              sequence="1"/>

    <menuitem id="menu_cyber_customer_credit_note"
              parent="menu_cyber_customer_root"
              name="Giấy báo có"
              action="action_cyber_customer_credit_note"
              sequence="2"/>

    <menuitem id="menu_cyber_customer_payment"
              parent="menu_cyber_customer_root"
              name="Thanh toán"
              action="action_cyber_customer_payment"
              sequence="3"/>
</odoo>
