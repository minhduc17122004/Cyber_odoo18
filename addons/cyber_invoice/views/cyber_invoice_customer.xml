<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- MENU KHÁCH HÀNG -->
    <menuitem id="menu_cyber_customer_root"
              name="Khách hàng"
              parent="menu_cyber_invoice_root"
              sequence="10"/>

    <!-- LIST VIEW -->
    <record id="view_cyber_customer_list" model="ir.ui.view">
        <field name="name">cyber.customer.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Hóa đơn khách hàng">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="amount_total"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_cyber_customer_form" model="ir.ui.view">
        <field name="name">cyber.customer.form</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <form string="Hóa đơn khách hàng">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="invoice_date"/>
                        <field name="amount_total"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION HÓA ĐƠN -->
    <record id="action_cyber_customer_invoice" model="ir.actions.act_window">
        <field name="name">Hóa đơn</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU HÓA ĐƠN KHÁCH HÀNG -->
    <menuitem id="menu_cyber_customer_invoice"
              parent="menu_cyber_customer_root"
              name="Hóa đơn"
              action="action_cyber_customer_invoice"
              sequence="1"/>
</odoo>
