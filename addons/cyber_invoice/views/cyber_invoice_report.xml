<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- MENU BÁO CÁO -->
    <menuitem id="menu_cyber_report_root"
              name="Báo cáo"
              parent="menu_cyber_invoice_root"
              sequence="30"/>
    <!-- LIST VIEW -->
    <record id="view_cyber_invoice_analysis_list" model="ir.ui.view">
        <field name="name">cyber.invoice.analysis.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Phân tích hóa đơn">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="move_type"/>
                <field name="amount_total"/>
            </list>
        </field>
    </record>
    <!-- FORM VIEW -->
    <record id="view_cyber_invoice_analysis_form" model="ir.ui.view">
        <field name="name">cyber.invoice.analysis.form</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <form string="Phân tích hóa đơn">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="move_type"/>
                        <field name="amount_total"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION PHÂN TÍCH -->
    <record id="action_cyber_invoice_analysis" model="ir.actions.act_window">
        <field name="name">Phân tích hóa đơn</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU PHÂN TÍCH -->
    <menuitem id="menu_cyber_invoice_analysis"
              parent="menu_cyber_report_root"
              name="Phân tích hóa đơn"
              action="action_cyber_invoice_analysis"
              sequence="1"/>
</odoo>



