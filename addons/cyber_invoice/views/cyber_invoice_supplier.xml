<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- MENU NHÀ CUNG CẤP -->
    <menuitem id="menu_cyber_supplier_root"
              name="Nhà cung cấp"
              parent="menu_cyber_invoice_root"
              sequence="20"/>

    <!-- LIST VIEW -->
    <record id="view_cyber_supplier_list" model="ir.ui.view">
        <field name="name">cyber.supplier.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Hóa đơn nhà cung cấp">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="amount_total"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_cyber_supplier_form" model="ir.ui.view">
        <field name="name">cyber.supplier.form</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <form string="Hóa đơn nhà cung cấp">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="invoice_date"/>
                        <field name="amount_total"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTIONS -->
    <!-- Action Hóa đơn -->
    <record id="action_cyber_supplier_invoice" model="ir.actions.act_window">
        <field name="name">Hóa đơn</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice')]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'default_journal_id': False}</field>
    </record>

    <!-- Action Đơn hoàn tiền (Refund) -->
    <record id="action_cyber_supplier_refund" model="ir.actions.act_window">
        <field name="name">Đơn hoàn tiền</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in_refund')]</field>
        <field name="context">{'default_move_type': 'in_refund', 'default_journal_id': False}</field>
    </record>

    <!-- Action Thanh toán (Payment) -->
    <record id="action_cyber_supplier_payment" model="ir.actions.act_window">
        <field name="name">Thanh toán</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_type', '=', 'outbound'), ('partner_type', '=', 'supplier')]</field>
        <field name="context">{'default_payment_type': 'outbound', 'default_partner_type': 'supplier'}</field>
    </record>

    <!-- MENU ITEMS -->
    <menuitem id="menu_cyber_supplier_invoice"
              parent="menu_cyber_supplier_root"
              name="Hóa đơn"
              action="action_cyber_supplier_invoice"
              sequence="1"/>

    <menuitem id="menu_cyber_supplier_refund"
              parent="menu_cyber_supplier_root"
              name="Đơn hoàn tiền"
              action="action_cyber_supplier_refund"
              sequence="2"/>

    <menuitem id="menu_cyber_supplier_payment"
              parent="menu_cyber_supplier_root"
              name="Thanh toán"
              action="action_cyber_supplier_payment"
              sequence="3"/>
</odoo>
