<odoo>
  <data>

    <!-- ====== List view (thay tree bằng list) ====== -->
    <record id="view_cyber_customer_list" model="ir.ui.view">
      <field name="name">cyber.customer.list</field>
      <field name="model">cyber.customer</field>
      <field name="arch" type="xml">
        <list string="Cyber Customers">
          <field name="name"/>
          <field name="segment_name"/>
          <field name="phone"/>
          <field name="join_date"/>
          <field name="total_play_time"/>
          <field name="total_spent"/>
        </list>
      </field>
    </record>

    <!-- ====== Form view ====== -->
    <record id="view_cyber_customer_form" model="ir.ui.view">
      <field name="name">cyber.customer.form</field>
      <field name="model">cyber.customer</field>
      <field name="arch" type="xml">
        <form string="Cyber Customer">
          <sheet>
            <group>
              <field name="name"/>
              <field name="segment_name" readonly="1"/>
              <field name="phone"/>
              <field name="dob"/>
              <field name="join_date"/>
              <field name="total_play_time" readonly="1"/>
              <field name="total_spent" readonly="1"/>
              <field name="last_sesion_end"/>
              <field name="last_topup_date"/>
              <field name="last_spend_date"/>
              <field name="created_at" readonly="1"/>  
              <field name="updated_at" readonly="1"/>
            </group>

            <!-- 👇 Tab Accounts -->
            
          </sheet>
        </form>
      </field>
    </record>

    <!-- ====== Action ====== -->
    <record id="action_cyber_customer" model="ir.actions.act_window">
      <field name="name">Khách hàng</field>
      <field name="res_model">cyber.customer</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- ====== Menu ====== -->
    <menuitem id="menu_cyber_root" name="Cyber"/>
    <menuitem id="menu_cyber_customer"
              name="Khách hàng"
              parent="menu_cyber_root"
              action="action_cyber_customer"/>

  </data>
</odoo>
