<odoo>
  <data>
    
    <!-- Tạo form view cho cyber.account -->
    <record id="view_cyber_account_form_in_customer" model="ir.ui.view">
      <field name="name">cyber.account.form.in.customer</field>
      <field name="model">cyber.account</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <group>
                <field name="username" string="Tên tài khoản"/>
                <field name="password" password="True" string="Mật khẩu"/>
                <field name="customer_id" options="{'no_create': True}" string="Tên khách hàng"/>
                <field name="state" string="Trạng thái"/>
              </group>
              <group>
                <field name="balance" readonly="1" string="Số dư (VND)"/>
                <field name="play_time_total" string="Tổng thời gian đã chơi (giờ)"/>
                <field name="play_time_remaining" readonly="1" string="Thời gian còn lại (giờ)"/>
                <field name="total_spent" readonly="1" string="Tổng chi tiêu (VND)"/>
                <field name="total_recharge" readonly="1" string="Tổng nạp tiền (VND)"/>
                <field name="last_session_end" readonly="1" string="Ngày chơi gần nhất"/>
                <field name="last_topup_date" readonly="1" string="Ngày nạp tiền gần nhất"/>
                <field name="last_spend_date" readonly="1" string="Ngày chi tiêu gần nhất"/>
                <field name="create_date" readonly="1" string="Ngày tạo"/>
                <field name="write_date" readonly="1" string="Ngày cập nhập"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    
    <!-- Tạo list view riêng cho cyber.account -->
    <record id="view_cyber_account_list_in_customer" model="ir.ui.view">
      <field name="name">cyber.account.list.in.customer</field>
      <field name="model">cyber.account</field>
      <field name="arch" type="xml">
        <list>
          <field name="username" string="Tên tài khoản"/>
          <field name="balance" string="Số dư (VND)"/>
          <field name="play_time_total" string="Tổng thời gian đã chơi (giờ)"/>
          <field name="total_spent" string="Tổng chi tiêu (VND)"/>
          <field name="total_recharge" string="Tổng nạp tiền (VND)"/>
          <field name="state" string="Trạng thái"/>
        </list>
      </field>
    </record>
    
    <!-- Inherit form view của cyber.customer để thêm tab Accounts -->
    <record id="view_cyber_customer_form_inherit_accounts" model="ir.ui.view">
      <field name="name">cyber.customer.form.inherit.accounts</field>
      <field name="model">cyber.customer</field>
      <field name="inherit_id" ref="cyber_customer.view_cyber_customer_form"/>
      <field name="arch" type="xml">
        <xpath expr="//sheet" position="inside">
          <notebook>
            <page string="Danh sách tài khoản">
              <field name="account_ids" nolabel="1" readonly="1"/>
            </page>
          </notebook>
        </xpath>
      </field>
    </record>

  </data>
</odoo>