<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- ===== Form View ===== -->
        <record id="cyber_account_form_view" model="ir.ui.view">
            <field name="name">cyber.account.form.view</field>
            <field name="model">cyber.account</field>
            <field name="arch" type="xml">
                <form string="Cyber Account">
                    <sheet>
                        <div class="oe_title">
                            <label for="username" string="Username" class="oe_edit_only"/>
                            <h1><field name="username" placeholder="e.g. gamer01"/></h1>
                            <label for="customer_id"/>
                            <h3><field name="customer_id"/></h3>
                        </div>

                        <group name="main_info">
                            <group>
                                <field name="password" password="True"/>
                                <field name="balance"/>
                            </group>
                            <group>
                                <field name="discount_id"/>
                                <field name="state"/>
                            </group>
                        </group>

                        <group>
                            <field name="last_session"/>
                        </group>

                        <notebook>
                            <!-- <page string="Sessions">
                                <field name="session_ids">
                                    <tree string="Sessions">
                                        <field name="name"/>
                                        <field name="product_mac"/>
                                        <field name="start_time"/>
                                        <field name="end_time"/>
                                        <field name="price"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page> -->

                            <!-- <page string="Transactions">
                                <field name="transaction_ids">
                                    <tree string="Transactions">
                                        <field name="type"/>
                                        <field name="invoice_id"/>
                                        <field name="amount"/>
                                        <field name="payment_method"/>
                                        <field name="create_date"/>
                                    </tree>
                                </field>
                            </page> -->
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ===== Tree View ===== -->
        <record id="cyber_account_tree_view" model="ir.ui.view">
            <field name="name">cyber.account.tree.view</field>
            <field name="model">cyber.account</field>
            <field name="arch" type="xml">
                <list string="Cyber Accounts" default_order="create_date desc">
                    <field name="username"/>
                    <field name="customer_id"/>
                    <field name="discount_id"/>
                    <field name="balance"/>
                    <field name="state"/>
                    <field name="last_session"/>
                </list>
            </field>
        </record>

        <!-- ===== Action ===== -->
        <!-- ===== Action ===== -->
<record id="action_cyber_account" model="ir.actions.act_window">
    <field name="name">Cyber Account</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">cyber.account</field>
    <field name="view_mode">list,form</field>
</record>



        <!-- ===== Menu ===== -->
        <menuitem id="menu_cyber_account_root"
            name="Cyber Management"
            sequence="10"
            groups="base.group_user"/>

        <menuitem id="menu_cyber_account"
            name="Accounts"
            parent="menu_cyber_account_root"
            action="action_cyber_account"
            sequence="20"
            groups="base.group_user"/>
    </data>
</odoo>
