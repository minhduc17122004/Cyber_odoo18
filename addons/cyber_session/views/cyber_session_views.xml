<odoo>
    <!-- FORM VIEW -->
    <record id="view_cyber_session_form" model="ir.ui.view">
        <field name="name">cyber.session.form</field>
        <field name="model">cyber.session</field>
        <field name="arch" type="xml">
             <form string="Cyber Session">
                 <header>
                     <button name="action_close_manual" string="Đóng phiên" type="object"
                             invisible="state != 'running'" class="btn-primary"/>
                     <field name="state" widget="statusbar" statusbar_visible="running,closed"/>
                 </header>
                 <sheet>
                     <div class="oe_title">
                         <h1>
                             <field name="name" readonly="1"/>
                         </h1>
                     </div>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="cyber_product_machine_id"/>
                            <field name="price_per_hour"/>
                            <field name="total_cost" readonly="1"/>
                        </group>
                        <group>
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="end_time_expected" readonly="1"/>
                            <field name="duration" readonly="1"/>
                            <field name="play_time_remaining_virtual" 
                                   string="Thời gian còn lại (giờ)" 
                                   readonly="1"
                                   widget="float_time"
                                   invisible="state != 'running'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- TAB ORDERS -->
                        <page string="Đơn hàng trong phiên">
                            <field name="order_ids" context="{'default_session_id': id}">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="line_total" readonly="1"/>
                                    <field name="note"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="price_unit"/>
                                        <field name="line_total" readonly="1"/>
                                        <field name="note"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_cyber_session_list" model="ir.ui.view">
        <field name="name">cyber.session.list</field>
        <field name="model">cyber.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="account_id"/>
                <field name="cyber_product_machine_id"/>
                <field name="start_time"/>
                <field name="duration"/>
                <field name="play_time_remaining_virtual" 
                       string="Thời gian còn lại" 
                       widget="float_time"
                       optional="show"/>
                <field name="total_cost"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_cyber_session" model="ir.actions.act_window">
        <field name="name">Phiên chơi</field>
        <field name="res_model">cyber.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
