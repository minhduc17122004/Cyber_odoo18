<odoo>
  <record id="view_cyber_session_tree" model="ir.ui.view">
    <field name="name">cyber.session.tree</field>
    <field name="model">cyber.session</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="account_id"/>
        <field name="machine_id"/>
        <field name="start_time"/>
        <field name="end_time"/>
        <field name="duration"/>
        <field name="total_cost"/>
        <field name="state"/>
      </tree>
    </field>
  </record>

  <record id="view_cyber_session_form" model="ir.ui.view">
    <field name="name">cyber.session.form</field>
    <field name="model">cyber.session</field>
    <field name="arch" type="xml">
      <form string="Cyber Game Session">
        <sheet>
          <group>
            <field name="name"/>
            <field name="account_id"/>
            <field name="machine_id"/>
            <field name="price_per_hour"/>
            <field name="start_time"/>
            <field name="end_time"/>
            <field name="duration" readonly="1"/>
            <field name="total_cost" readonly="1"/>
            <field name="state" readonly="1"/>
          </group>
          <footer>
            <button name="action_start" type="object" string="Start Session" states="draft" class="btn-primary"/>
            <button name="action_end" type="object" string="End Session" states="running" class="btn-secondary"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_cyber_session" model="ir.actions.act_window">
    <field name="name">Game Sessions</field>
    <field name="res_model">cyber.session</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>