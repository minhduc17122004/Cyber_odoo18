<odoo>
    <!-- FORM VIEW -->
    <record id="view_cyber_session_form" model="ir.ui.view">
        <field name="name">cyber.session.form</field>
        <field name="model">cyber.session</field>
        <field name="arch" type="xml">
             <form string="Cyber Session">
                 <header>
                     <button name="action_start_session" string="Start Session" type="object"
                             invisible="session_state != 'draft'" class="btn-primary"/>
                     <button name="action_close_session" string="Close Session" type="object"
                             invisible="session_state != 'running'" class="btn-primary"/>
                     <field name="session_state" widget="statusbar" statusbar_visible="draft,running,closed"/>
                 </header>
                 <sheet>
                     <div class="oe_title">
                         <h1>
                             <field name="name" readonly="1"/>
                         </h1>
                     </div>
                    <group>
                        <group>
                            <field name="account_id" string="Tài khoản"/>
                            <field name="product_machine_id" string="Máy"/>
                            <field name="price_per_hour"/>
                            <field name="total_service" readonly="1" widget="monetary" string="Tổng dịch vụ (VND)"/>
                            <field name="total_order" readonly="1" widget="monetary" string="Tổng đơn hàng (VND)"/>
                            <field name="total_sale" readonly="1" widget="monetary" string="Tổng cộng (VND)" class="oe_subtotal_footer_separator"/>
                            <field name="available_balance" 
                                   string="Số dư khả dụng trong phiên" 
                                   readonly="1"
                                   invisible="session_state != 'running'"
                                   widget="monetary"/>
                        </group>
                        <group>
                            <field name="start_time" string="Thời gian bắt đầu" invisible="session_state == 'draft'"/>
                            <field name="end_time" string="Thời gian kết thúc" invisible="session_state != 'closed'"/>
                            <field name="end_time_expected" 
                                   string="Thời gian đóng phiên dự kiến" 
                                   readonly="1"
                                   widget="datetime"
                                   invisible="session_state != 'running'"/>
                            <field name="duration" readonly="1" string="Thời lượng (giờ)"/>
                            <field name="time_remaining" 
                                   string="Thời gian còn lại" 
                                   readonly="1"
                                   widget="float_time"
                                   invisible="session_state != 'running'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- TAB ORDERS -->
                        <page string="Orders in Session">
                            <field name="order_ids" context="{'default_session_id': id}">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="line_total" readonly="1"/>
                                    <field name="order_state"/>
                                    <field name="note"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="price_unit"/>
                                        <field name="line_total" readonly="1"/>
                                        <field name="order_state"/>
                                         <field name="note"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_cyber_session_list" model="ir.ui.view">
        <field name="name">cyber.session.list</field>
        <field name="model">cyber.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="account_id" string="Tài khoản"/>
                <field name="product_machine_id" string="Máy"/>
                <field name="start_time" string="Thời gian bắt đầu"/>
                <field name="end_time_expected" 
                       string="Đóng phiên dự kiến"
                       widget="datetime"
                       optional="show"/>
                <field name="duration" string="Thời lượng (giờ)"/>
                <field name="time_remaining" 
                       string="Thời gian còn lại" 
                       widget="float_time"
                       optional="show"/>
                <field name="total_service" string="Tổng dịch vụ" optional="show"/>
                <field name="total_order" string="Tổng đơn hàng" optional="show"/>
                <field name="total_sale" string="Tổng cộng"/>
                <field name="session_state" string="Trạng thái"/>
            </list>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_cyber_session" model="ir.actions.act_window">
        <field name="name">Cyber Sessions</field>
        <field name="res_model">cyber.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
