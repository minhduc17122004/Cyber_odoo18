<odoo>
<record id="view_cyber_session_tree" model="ir.ui.view">
<field name="name">cyber.session.tree</field>
<field name="model">cyber.session</field>
<field name="arch" type="xml">
<list string="Cyber Sessions">
<field name="name"/>
<field name="account_id"/>
<!-- <field name="machine_id"/> -->
<field name="start_time"/>
<field name="end_time"/>
<!-- <field name="end_time_expected"/> -->
<field name="duration"/>
<field name="total_cost"/>
<field name="state"/>
</list>
</field>
</record>


<record id="view_cyber_session_form" model="ir.ui.view">
<field name="name">cyber.session.form</field>
<field name="model">cyber.session</field>
<field name="arch" type="xml">
<form string="Cyber Session">
<header>
<button name="action_close_manual" string="Close Session" type="object" invisible="state == 'closed'" class="oe_highlight"/>
<field name="state" widget="statusbar" statusbar_visible="running,closed"/>
</header>
<sheet>
<group>
<group>
<field name="name"/>
<field name="account_id" options="{'no_create': True}"/>
<!-- <field name="machine_id"/> -->
</group>
<group>
<field name="start_time"/>
<field name="end_time"/>
<field name="duration" readonly="1"/>
<field name="price_per_hour"/>
<field name="total_cost" readonly="1"/>
</group>
</group>
</sheet>
</form>
</field>
</record>


<record id="action_cyber_session" model="ir.actions.act_window">
<field name="name">Cyber Sessions</field>
<field name="res_model">cyber.session</field>
<field name="view_mode">list,form</field>
</record>

