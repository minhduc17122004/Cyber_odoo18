<odoo>
    <data noupdate="1">
        <record id="ir_cron_close_expired_sessions" model="ir.cron">
            <field name="name">Close Expired Cyber Sessions</field>
            <field name="model_id" ref="model_cyber_session"/> <!-- phải tồn tại ir.model -->
            <field name="state">code</field>
            <field name="code"><![CDATA[
model.action_autoclose_sessions()
            ]]></field>
            <field name="interval_type">minutes</field>
            <field name="interval_number">5</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>